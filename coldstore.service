[Unit]
Description=Cold-chain decoy (Danfoss AK-SM 800A: Modbus 502, StoreView 8443, SNMP 5136/udp, Service Tool 1041, PI200 1041/udp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coldstore
Group=coldstore
WorkingDirectory=/opt/coldstore
Environment=PYTHONUNBUFFERED=1
Environment=COLDSTORE_LOG=/var/log/coldstore/coldstore.jsonl
Environment=COLDSTORE_MODBUS_BIND=0.0.0.0:502
Environment=COLDSTORE_WEB_BIND=0.0.0.0:8443
Environment=COLDSTORE_SNMP_BIND=0.0.0.0:5136
Environment=COLDSTORE_SERVICETOOL_BIND=0.0.0.0:1041
Environment=COLDSTORE_PI200_BIND=0.0.0.0:1041
Environment=COLDSTORE_CERT=/etc/coldstore/cert.pem
Environment=COLDSTORE_KEY=/etc/coldstore/key.pem
Environment=COLDSTORE_ST_CERT=/etc/coldstore/st_cert.pem
Environment=COLDSTORE_ST_KEY=/etc/coldstore/st_key.pem
ExecStart=/usr/bin/python3 /opt/coldstore/coldstore.py
Restart=always
RestartSec=3
Nice=5
# the one writable place is the log directory, created and owned by systemd for this unit
LogsDirectory=coldstore
ReadOnlyPaths=/opt/coldstore /etc/coldstore
# bind 502 (<1024) but hold no other privilege
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
